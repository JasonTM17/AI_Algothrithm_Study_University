flowchart TD
    A["master branch<br/>official grading line"]:::root

    A --> B["Academic Dashboard UI"]:::ui
    B --> B1["Play<br/>inspect state and solvability"]
    B --> B2["Run Algorithm<br/>frontier, reached, trace"]
    B --> B3["Compare<br/>methodology and ratios"]
    B --> B4["Theory / PEAS<br/>proof cards and taxonomy"]
    B --> B5["Hand-Tracing<br/>manual expansion practice"]

    A --> C["AI Course Framing"]:::academic
    C --> C1["Real solvers<br/>BFS, UCS, IDS, A*, IDA*"]
    C --> C2["Contrast demos<br/>DFS, Greedy, local search"]
    C --> C3["Illustrative extensions<br/>CSP, AND-OR, partial observation"]
    C --> C4["Game / stochastic demos<br/>Minimax, Alpha-Beta, Expectimax"]

    A --> D["CSP Boundary"]:::warning
    D --> D1["15-puzzle CSP explanations<br/>educational reformulation"]
    D --> D2["Graph coloring<br/>separate map-coloring CSP demo"]
    D --> D3["No coloring claim<br/>for natural 15-puzzle solving"]

    A --> E["Web Learning Lab"]:::app
    E --> E1["Manual puzzle game<br/>legal clicks, undo, scoring"]
    E --> E2["Optimality challenge<br/>A* + Linear Conflict certificate"]
    E --> E3["Search evidence<br/>verified nodes and directed edges"]
    E --> E4["Concept Lab<br/>separate extension environments"]

    A --> F["Verification Pipeline"]:::verify
    F --> F1["compileall<br/>app, core, algorithms, ui"]
    F --> F2["pytest<br/>heuristics, paths, trees, taxonomy"]
    F --> F3["Streamlit AppTest + health<br/>interactive web flow"]
    F --> F4["Git hygiene<br/>master default, secret scan, no dist artifacts"]

    classDef root fill:#172033,stroke:#5f8cff,color:#ffffff,stroke-width:2px;
    classDef ui fill:#e9f1ff,stroke:#5f8cff,color:#172033;
    classDef academic fill:#eaf7f0,stroke:#2f9e63,color:#123524;
    classDef warning fill:#fff3d6,stroke:#d19a00,color:#3b2b00;
    classDef app fill:#f1ecff,stroke:#7c5cff,color:#251447;
    classDef verify fill:#eef2f4,stroke:#61717a,color:#1d2b31;
